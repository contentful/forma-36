{
  "name": "forma-36-monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "packages/components/*"
  ],
  "description": "Forma 36 - The Contentful Design System",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contentful/forma-36.git"
  },
  "bugs": {
    "url": "https://github.com/contentful/forma-36/issues"
  },
  "homepage": "https://github.com/contentful/forma-36#readme",
  "scripts": {
    "build": "turbo run build",
    "generate": "plop --plopfile scripts/plopfile.js",
    "lint": "pnpm lint:js && pnpm lint:packages",
    "lint:js": "eslint packages --ext .js,.jsx,.ts,.tsx",
    "lint:packages": "node scripts/lint-packages.js",
    "prettier": "prettier --write '**/*.{jsx,js,ts,tsx,md,mdx}'",
    "prettier:check": "prettier --check '**/*.{jsx,js,ts,tsx,md,mdx}'",
    "pretty:quick": "pretty-quick --staged --pattern '**/*.*(js|jsx|ts|tsx|md|mdx)'",
    "storybook": "storybook dev -p 9001 -c ./scripts/.storybook",
    "storybook:build": "storybook build -c ./scripts/.storybook -o dist-storybook --webpack-stats-json",
    "test": "pnpm test:vitest",
    "test:watch": "vitest",
    "test:vitest": "pnpm --filter @contentful/f36-tokens build && vitest run",
    "tsc": "tsc --noEmit",
    "tsc:watch": "tsc --noEmit --watch",
    "docs": "pnpm docs:next",
    "docs:next": "turbo run start --filter=@contentful/f36-website --parallel --no-cache",
    "docs:next:build": "turbo run build:prod --filter=@contentful/f36-website --parallel --force",
    "docs:next:start-prod": "turbo run start:prod --filter=@contentful/f36-website --parallel",
    "changelog:gen": "node scripts/changesets/changelog-generate.js",
    "changelog:write": "node scripts/changesets/changelog-write.js",
    "changeset:publish": "node scripts/changesets/generate-releases.js",
    "release:smoke-test": "node scripts/changesets/smoke-test-release.js",
    "release:smoke-test:write": "node scripts/changesets/smoke-test-release.js --write",
    "postversion": "prettier",
    "prerelease": "node scripts/prerelease.mjs",
    "figma:publish": "figma connect publish --token $FIGMA_ACCESS_TOKEN",
    "figma:publish:dry": "figma connect publish --token $FIGMA_ACCESS_TOKEN --dry-run",
    "figma:unpublish": "figma connect unpublish --token $FIGMA_ACCESS_TOKEN"
  },
  "packageManager": "pnpm@11.21.0",
  "browserslist": "extends @contentful/browserslist-config",
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.27.1",
    "@changesets/assemble-release-plan": "^6.0.9",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.28.1",
    "@changesets/config": "^3.1.1",
    "@changesets/pre": "^2.0.2",
    "@changesets/read": "^0.6.3",
    "@chromatic-com/storybook": "^5.2.1",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@contentful/browserslist-config": "^4.0.0",
    "@contentful/f36-badge": "workspace:*",
    "@contentful/f36-button": "workspace:*",
    "@contentful/f36-components": "workspace:*",
    "@contentful/f36-copybutton": "workspace:*",
    "@contentful/f36-core": "workspace:*",
    "@contentful/f36-forms": "workspace:*",
    "@contentful/f36-icon": "workspace:*",
    "@contentful/f36-icons": "workspace:*",
    "@contentful/f36-list": "workspace:*",
    "@contentful/f36-menu": "workspace:*",
    "@contentful/f36-navbar": "workspace:*",
    "@contentful/f36-note": "workspace:*",
    "@contentful/f36-pill-next": "workspace:*",
    "@contentful/f36-text-link": "workspace:*",
    "@contentful/f36-tokens": "workspace:*",
    "@contentful/f36-tooltip": "workspace:*",
    "@contentful/f36-typography": "workspace:*",
    "@dnd-kit/core": "^6.0.8",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.1",
    "@emotion/babel-plugin": "^11.13.5",
    "@emotion/eslint-plugin": "^11.12.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.0",
    "@figma/code-connect": "^1.4.4",
    "@manypkg/get-packages": "1.1.3",
    "@size-limit/preset-big-lib": "^13.0.0",
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/react-vite": "^10.4.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "axe-core": "^4.12.1",
    "chalk": "^5.6.2",
    "chromatic": "^18.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.4.2",
    "fast-glob": "^3.3.3",
    "globals": "^17.4.0",
    "globby": "^15.0.0",
    "inquirer": "^12.9.6",
    "jsdom": "^29.0.0",
    "knip": "^6.25.0",
    "lint-staged": "^16.4.0",
    "octokit": "^3.0.0",
    "plop": "^4.0.5",
    "prettier": "3.9.6",
    "pretty-quick": "4.2.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "semver": "^7.7.3",
    "simple-git-hooks": "^2.13.1",
    "size-limit": "^13.0.0",
    "storybook": "^10.4.2",
    "tsup": "^8.5.0",
    "turbo": "^2.9.14",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix --prune-suppressions"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm pretty:quick && pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint -e \"$@\""
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3"
  }
}
