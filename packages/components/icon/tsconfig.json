{
  "extends": "../../../tsconfig.json",
  "include": ["src/**/*"],
  "exclude": ["dist/**/*", "**/*.test.tsx"],
  "compilerOptions": {
    "allowJs": false,
    "declaration": true,
    "noEmit": false,
    "inlineSources": true,
    "inlineSourceMap": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "./src",
    "outDir": "./dist/esm/"
  }
}
