{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "unlisted",
    "binaries",
    "unresolved",
    "exports",
    "nsExports",
    "types",
    "nsTypes",
    "enumMembers",
    "namespaceMembers",
    "duplicates",
    "cycles"
  ],
  "entry": [
    "scripts/**/*.{js,ts,tsx,mjs}",
    "*.config.{js,mjs,ts}",
    "tsup.config.ts"
  ],
  "ignoreDependencies": [
    "@changesets/cli",
    "@contentful/browserslist-config",
    "@contentful/f36-navbar",
    "@contentful/f36-pill-next",
    "@floating-ui/react-dom",
    "@testing-library/jest-dom",
    "chromatic",
    "globby",
    "wait-on"
  ],
  "storybook": {
    "config": ["scripts/.storybook/main.ts"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/.storybook/{manager,preview}.{ts,tsx}",
        "scripts/changesets/**/*.test.js",
        "scripts/plopfile.js",
        "scripts/plop-templates/**/*.js",
        "scripts/test/*.{js,ts}"
      ],
      "ignoreUnresolved": ["^\\.\\./\\.\\./utils(?:/config)?$"]
    },
    "packages/components/*": {
      "entry": [
        "src/index.{js,ts,tsx}",
        "src/**/*.{test,figma}.{js,jsx,ts,tsx}",
        "stories/**/*.{js,jsx,ts,tsx}",
        "**/examples/**/*.{js,jsx,ts,tsx}"
      ],
      "ignoreIssues": {
        "**/*.mdx": ["unlisted"],
        "stories/**/*.{js,jsx,ts,tsx}": ["unlisted"],
        "**/examples/**/*.{js,jsx,ts,tsx}": ["unlisted"]
      }
    },
    "packages/cdn": {
      "entry": ["src/index.js", "static-publish.rc.js"]
    },
    "packages/core": {
      "entry": [
        "src/index.{js,ts,tsx}",
        "src/**/*.test.{js,jsx,ts,tsx}",
        "src/**/examples/**/*.{js,jsx,ts,tsx}",
        "stories/**/*.{js,jsx,ts,tsx}"
      ],
      "ignoreIssues": {
        "src/**/*.mdx": ["unlisted"],
        "stories/**/*.{js,jsx,ts,tsx}": ["unlisted"],
        "src/**/examples/**/*.{js,jsx,ts,tsx}": ["unlisted"]
      }
    },
    "packages/f36-ai-components": {
      "entry": [
        "src/**/*.test.{ts,tsx}",
        "stories/**/*.{ts,tsx}"
      ],
      "ignoreIssues": {
        "stories/**/*.{ts,tsx}": ["unlisted"]
      }
    },
    "packages/f36-i18n-utils": {
      "entry": ["src/index.ts", "src/**/*.test.{js,jsx,ts,tsx}"]
    },
    "packages/forma-36-codemod": {
      "entry": [
        "bin/*.mjs",
        "transforms/**/*.{js,ts,tsx}",
        "utils/**/*.js"
      ],
      "ignoreIssues": {
        "transforms/__testfixtures__/**/*.{js,jsx,ts,tsx}": ["unlisted"]
      }
    },
    "packages/forma-36-react-components": {
      "ignoreDependencies": ["@contentful/browserslist-config"]
    },
    "packages/forma-36-tokens": {
      "entry": ["src/tokens/**/*.js"]
    },
    "packages/website": {
      "entry": [
        "pages/**/*.{js,jsx,ts,tsx}",
        "scripts/**/*.{js,jsx,ts,tsx}",
        "content/**/*.{js,jsx,ts,tsx,md,mdx}"
      ],
      "ignoreDependencies": [
        "@next/eslint-plugin-next",
        "broken-link-checker"
      ]
    }
  }
}
